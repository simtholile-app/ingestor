# Storage Mode: 'local' or 'remote'
STORAGE_MODE=local

# Local Storage Directory (Used when STORAGE_MODE=local)
LOCAL_OUTPUT_DIR=local_data

# Remote Config (Used when STORAGE_MODE=remote)
FIREBASE_CREDENTIALS_JSON=path/to/serviceAccountKey.json
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Author UUID for all ingested cases
AUTHOR_USER_ID=0rC9Xbe62uQUf69uRNciXYaeR0O2
